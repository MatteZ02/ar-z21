{
  "expo": {
    "name": "Throttle",
    "slug": "throttle",
    "scheme": "throttle",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fi.alppirautatiet.throttle",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Throttle connects to your layout's Z21 central unit on the local Wi-Fi network.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fi.alppirautatiet.throttle",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B3A52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Throttle uses your photos to show your locomotives in the library.",
          "cameraPermission": "Throttle uses the camera to take photos of your locomotives for the library.",
          "microphonePermission": false
        }
      ],
      "./plugins/withReleaseSigning"
    ]
  }
}
