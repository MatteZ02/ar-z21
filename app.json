{
  "expo": {
    "name": "AR Z21",
    "slug": "ar-z21",
    "scheme": "arz21",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.arz21",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Used to connect to your layout's Z21 central unit on the local Wi-Fi network."
      }
    },
    "android": {
      "package": "com.example.arz21",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to choose photos of your locomotives for the library.",
          "cameraPermission": "Used to take photos of your locomotives for the library.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
